# Node.js authoritative server
PORT=3001
# 127.0.0.1 keeps it local. Use 0.0.0.0 if another machine must connect.
HOST=127.0.0.1

# Supabase project URL, for example https://your-project-ref.supabase.co
SUPABASE_URL=

# Server-only key. Fill exactly one of these (never use a VITE_ prefix).
# New Supabase projects use a sb_secret_... key.
# Do not use the sb_publishable_... key here.
SUPABASE_SECRET_KEY=
# Alternative aliases:
# SUPABASE_SERVER_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# The core tables were created in the game schema; add `game` under
# Project Settings → API → Exposed schemas before using REST persistence.
SUPABASE_SCHEMA=game

# off | best-effort | required
# best-effort keeps the local demo alive if Supabase is temporarily unavailable.
SUPABASE_PERSISTENCE=best-effort
SUPABASE_BOOTSTRAP=true
SUPABASE_REQUEST_TIMEOUT_MS=5000
WORLD_CHUNK_SIZE=32

# Agent gateway. Format: key:actorId[,key:actorId]
# A key is bound to one world actor. Never commit production keys.
AGENT_API_KEYS=sk_local_scout:agent_001,sk_local_rover:agent_002,sk_local_wren:agent_003,sk_local_player:player_001
# Optional Vite key for the local world socket. Defaults to sk_local_scout.
# VITE_PLAYER_KEY=sk_local_player
